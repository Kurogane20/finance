# Production Environment Variables
# Copy this file to .env and update values

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# Domain (for CORS and SSL)
DOMAIN=finance.yourdomain.com

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your-secure-root-password
MYSQL_DATABASE=finance_db
MYSQL_USER=finance_user
MYSQL_PASSWORD=your-secure-db-password

# Database URL (auto-generated in docker-compose, only needed for manual setup)
# DATABASE_URL=mysql+pymysql://finance_user:password@localhost:3306/finance_db
