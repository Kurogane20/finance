# Production Environment Variables
# Copy this file to .env and update values
# IMPORTANT: All values must be set before running docker-compose

# ============================================
# SECURITY (REQUIRED - DO NOT USE DEFAULTS!)
# ============================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-min-32-chars

# Token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# DOMAIN CONFIGURATION
# ============================================
DOMAIN=finance.yourdomain.com

# ============================================
# MySQL Database Configuration
# ============================================
MYSQL_ROOT_PASSWORD=your-secure-root-password
MYSQL_DATABASE=finance_db
MYSQL_USER=finance_user
MYSQL_PASSWORD=your-secure-db-password

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Update frontend/.env.production with your actual API URL
# VITE_API_URL=https://your-domain.com/api
