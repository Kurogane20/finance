# ============================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================
# This file contains non-sensitive development defaults
# Safe to commit to version control

# Security (DEV ONLY - NOT SECURE)
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Domains
FRONTEND_DOMAIN=localhost
BACKEND_DOMAIN=localhost

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MySQL Database (DEV ONLY)
MYSQL_ROOT_PASSWORD=devroot123
MYSQL_DATABASE=finance_db
MYSQL_USER=finance_user
MYSQL_PASSWORD=devpassword123

# Seed Mode: "full" = demo data, "users_only" = production
SEED_MODE=full

# Frontend
VITE_API_URL=http://localhost:8000/api
